# MainStreet Shield environment variables
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://user:pass@localhost:5432/mainstreet_shield?schema=public"
SESSION_SECRET="change-me-to-a-random-32-char-secret"
NEXTAUTH_URL="https://mainstreetmint.click"
NEXTAUTH_SECRET="change-me-to-a-random-32-char-secret"

# Optional: Resend for email (signup invites, admin alerts)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
RESEND_FROM="MainStreet Shield <noreply@mainstreetmint.click>"

# Optional: Cline SDK key for agent → VM SSH access
CLINE_API_KEY=""

# Cline agent settings encryption (S2-8) — >=32 chars, used to encrypt stored API keys
CLINE_ENCRYPTION_KEY="change-me-to-a-random-32-char-key"

# Service token for server-to-server calls from SpaceWorker admin
# (spaceworker admin calls mainstreet-shield's /api/admin/invites)
MAINSTREET_SERVICE_TOKEN="change-me-to-a-random-secret"

# VPS connection (for deploy scripts, not in app runtime)
VPS_HOST="207.244.224.57"
VPS_USER="root"